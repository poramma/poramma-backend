# Postgres
POSTGRES_USER=poramma
POSTGRES_PASSWORD=poramma
POSTGRES_DB=poramma
POSTGRES_PORT=5432

# Database connection string used by the services running inside docker-compose.
# Host "db" is the docker-compose service name; 5432 is the container-internal
# Postgres port (POSTGRES_PORT above only controls the host-side mapping).
DATABASE_URL=postgres://poramma:poramma@db:5432/poramma

# Redis
REDIS_URL=redis://redis:6379

# MinIO
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=poramma-docs

# Mailhog (dev SMTP capture — view sent mail at http://localhost:8025).
# "mailhog" is the docker-compose service hostname; Mailhog accepts any
# credentials, so SMTP_USER/SMTP_PASS are placeholders, not real secrets.
# Without a .env.smtp file, no email ever reaches a real inbox (Mailhog only).
#
# REAL delivery: put the provider's credentials in .env.smtp (git-ignored, not
# in this tracked file) — docker-compose.yml loads it after this file, so its
# SMTP_* values win. SMTP_SECURE=true only for implicit TLS (port 465).
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=dev@poramma.ml
SMTP_PASS=dev
SMTP_FROM=dev@poramma.ml
# Every email is also dropped into Mailhog (when the main transport is a real
# SMTP server) so it can be inspected at http://localhost:8025 in dev.
MAIL_MIRROR_TO_MAILHOG=true
MAILHOG_HOST=mailhog
MAILHOG_PORT=1025
MAIL_FROM_NAME=Poramma
# Base URL of the citizen portal, used for the buttons/links inside emails.
PUBLIC_APP_URL=http://localhost:5174
# JWT
JWT_SECRET=super_secret_key_change_me
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# NOTE: PORT is deliberately NOT set here. This file is shared by all three
# services via `env_file: .env` in docker-compose.yml, so a single PORT value
# would force every service onto the same port. Each service's port is set
# per-service in docker-compose.yml (`environment: PORT=...`) and in its own
# services/<name>/.env for local `pnpm dev`.
