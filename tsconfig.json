{
    "compilerOptions": {
      "target": "ES2022",
      "module": "commonjs",
      "lib": ["ES2022"],
      "moduleResolution": "node",
      "rootDir": ".",
      "outDir": "./dist",
      "removeComments": true,
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "declaration": true,
      "declarationMap": true,
      "sourceMap": true,
      "baseUrl": ".",
      "paths": {
        "@fivision/dto": ["packages/dto/src"],
        "@fivision/types": ["packages/types/src"],
        "@fivision/utils": ["packages/utils/src"],
        "@fivision/storage": ["packages/storage/src"],
        "@fivision/queue": ["packages/queue/src"],
        "@fivision/mailer": ["packages/mailer/src"],
        "@fivision/notifier": ["packages/notifier/src"]
      }
    },
    "include": [
      "packages/**/*",
      "services/**/*"
    ],
    "exclude": [
      "node_modules",
      "dist",
      "**/*.test.ts",
      "**/*.spec.ts"
    ]
  }