# Local (non-Docker) development only. Inside docker-compose the root .env is
# used instead, which points DATABASE_URL at the "db" service host.
DATABASE_URL=postgres://poramma:poramma@localhost:5432/poramma
DATABASE_PASSWORD=poramma
JWT_SECRET=change_me_super_secret
PORT=4001

# Mailhog (dev SMTP capture — view sent mail at http://localhost:8025).
# For local (non-Docker) `pnpm dev`, "localhost" reaches the Mailhog
# container via its published port; Mailhog accepts any credentials.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=dev@poramma.ml
SMTP_PASS=dev
SMTP_FROM=dev@poramma.ml
