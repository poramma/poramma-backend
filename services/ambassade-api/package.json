{
  "name": "ambassade-api",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "drizzle:generate": "drizzle-kit generate --config ./src/db/drizzle.config.ts",
    "drizzle:push": "drizzle-kit push --config ./src/db/drizzle.config.ts",
    "lint": "eslint . --ext .ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@poramma/ambassade-core": "workspace:*",
    "@poramma/cache": "workspace:*",
    "@poramma/dto": "workspace:*",
    "@poramma/mailer": "workspace:*",
    "@poramma/storage": "workspace:*",
    "@poramma/utils": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.44.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.16.3",
    "sanitize-html": "^2.17.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.19",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.11",
    "@types/pg": "^8.15.5",
    "@types/sanitize-html": "^2.16.1",
    "drizzle-kit": "^0.31.4",
    "eslint": "^8.50.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vitest": "^2.1.9"
  }
}